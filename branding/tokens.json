{
  "$schema": "https://tr.designtokens.org/format/",
  "brand": "Terraço",
  "theme": "Ipê & Grafite",
  "color": {
    "bg": {
      "canvas": {
        "$value": "#F8F5EA",
        "$type": "color",
        "$description": "Creme Papel — Fundo principal"
      },
      "surface": {
        "$value": "#F1E9D8",
        "$type": "color",
        "$description": "Areia Suave — Superfícies secundárias e inputs"
      },
      "surfaceDeep": {
        "$value": "#E8DEC9",
        "$type": "color",
        "$description": "Areia Quente — Contraste tonal sutil"
      },
      "elevated": {
        "$value": "#FFFDF9",
        "$type": "color",
        "$description": "Branco Quente — Cards elevados e modais"
      }
    },
    "text": {
      "primary": {
        "$value": "#1E1D1B",
        "$type": "color",
        "$description": "Grafite Quente — Texto principal e wordmark"
      },
      "secondary": {
        "$value": "#57534E",
        "$type": "color",
        "$description": "Grafite Médio — Subtítulos e metadados"
      },
      "inverse": {
        "$value": "#F8F5EA",
        "$type": "color",
        "$description": "Texto sobre fundos escuros"
      }
    },
    "brand": {
      "primary": {
        "$value": "#2E5B46",
        "$type": "color",
        "$description": "Verde Musgo Urbano — CTAs principais e headers escuros"
      },
      "primaryHover": {
        "$value": "#234736",
        "$type": "color"
      },
      "container": {
        "$value": "#E3EFE8",
        "$type": "color",
        "$description": "Container tonal de Verde Musgo Urbano"
      },
      "accent": {
        "$value": "#EEB506",
        "$type": "color",
        "$description": "Amarelo Ipê Solar — Ícone do app e destaques de marca"
      },
      "accentHover": {
        "$value": "#D9A304",
        "$type": "color"
      },
      "accentSoft": {
        "$value": "#FBF1CE",
        "$type": "color"
      },
      "highlight": {
        "$value": "#ED7467",
        "$type": "color",
        "$description": "Rosa Goiaba — Favoritos e microinterações táteis (usar com #1E1D1B para contraste AA)"
      },
      "highlightSoft": {
        "$value": "#FCE4E0",
        "$type": "color"
      }
    },
    "border": {
      "subtle": {
        "$value": "#E4DCCB",
        "$type": "color"
      },
      "strong": {
        "$value": "#CFC5B2",
        "$type": "color"
      }
    },
    "semantic": {
      "success": {
        "fg": { "$value": "#2E5B46", "$type": "color" },
        "bg": { "$value": "#E4F0EA", "$type": "color" }
      },
      "warning": {
        "fg": { "$value": "#8A6500", "$type": "color" },
        "bg": { "$value": "#FEF3C7", "$type": "color" }
      },
      "error": {
        "fg": { "$value": "#B9382E", "$type": "color" },
        "bg": { "$value": "#FDE8E6", "$type": "color" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "display": {
        "$value": "'Fraunces', Georgia, serif",
        "$type": "fontFamily"
      },
      "sans": {
        "$value": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
        "$type": "fontFamily"
      }
    },
    "fontWeight": {
      "body": { "$value": 400, "$type": "fontWeight" },
      "heading": { "$value": 500, "$type": "fontWeight" },
      "ui": { "$value": 500, "$type": "fontWeight" }
    },
    "fontSize": {
      "displayXl": { "$value": "48px", "$type": "dimension" },
      "displayLg": { "$value": "36px", "$type": "dimension" },
      "headingMd": { "$value": "24px", "$type": "dimension" },
      "bodyMd": { "$value": "16px", "$type": "dimension" },
      "uiLabel": { "$value": "14px", "$type": "dimension" },
      "uiMeta": { "$value": "13px", "$type": "dimension" }
    }
  },
  "radius": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "m3md": { "$value": "12px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "morphPill": { "$value": "22px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "28px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "2xl": { "$value": "48px", "$type": "dimension" },
    "3xl": { "$value": "64px", "$type": "dimension" }
  },
  "shadow": {
    "chip": {
      "$value": "0 2px 8px -2px rgba(30, 29, 27, 0.08)",
      "$type": "shadow"
    },
    "card": {
      "$value": "0 8px 24px -6px rgba(30, 29, 27, 0.07)",
      "$type": "shadow"
    },
    "cardHover": {
      "$value": "0 14px 32px -10px rgba(30, 29, 27, 0.11)",
      "$type": "shadow"
    },
    "moss": {
      "$value": "0 10px 24px -8px rgba(46, 91, 70, 0.30)",
      "$type": "shadow"
    },
    "floating": {
      "$value": "0 24px 56px -14px rgba(30, 29, 27, 0.14), 0 4px 12px -2px rgba(30, 29, 27, 0.05)",
      "$type": "shadow"
    }
  },
  "motion": {
    "easeUi": {
      "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "$type": "cubicBezier"
    },
    "easeEnter": {
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
      "$type": "cubicBezier"
    },
    "easeSpringFast": {
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
      "$type": "cubicBezier",
      "$description": "Fallback para linear() M3 Expressive Spatial Spring Fast (320ms)"
    },
    "easeSpringDefault": {
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
      "$type": "cubicBezier",
      "$description": "Fallback para linear() M3 Expressive Spatial Spring Default (420ms)"
    }
  }
}
