{
  "$schema": "https://tr.designtokens.org/format/",
  "brand": "Terraço",
  "theme": "Ipê & Grafite",
  "color": {
    "bg": {
      "canvas": {
        "$value": "#F8F5EA",
        "$type": "color",
        "$description": "Creme Papel — Fundo principal"
      },
      "surface": {
        "$value": "#F1E9D8",
        "$type": "color",
        "$description": "Areia Suave — Superfícies secundárias e inputs"
      },
      "elevated": {
        "$value": "#FFFDF9",
        "$type": "color",
        "$description": "Branco Quente — Cards elevados e modais"
      }
    },
    "text": {
      "primary": {
        "$value": "#1E1D1B",
        "$type": "color",
        "$description": "Grafite Quente — Texto principal e wordmark"
      },
      "secondary": {
        "$value": "#57534E",
        "$type": "color",
        "$description": "Grafite Médio — Subtítulos e metadados"
      },
      "inverse": {
        "$value": "#F8F5EA",
        "$type": "color",
        "$description": "Texto sobre fundos escuros"
      }
    },
    "brand": {
      "primary": {
        "$value": "#2E5B46",
        "$type": "color",
        "$description": "Verde Musgo Urbano — CTAs principais e headers escuros"
      },
      "primaryHover": {
        "$value": "#234736",
        "$type": "color"
      },
      "accent": {
        "$value": "#EEB506",
        "$type": "color",
        "$description": "Amarelo Ipê Solar — Ícone do app e destaques de marca"
      },
      "highlight": {
        "$value": "#ED7467",
        "$type": "color",
        "$description": "Rosa Goiaba — Badges e microinterações"
      }
    },
    "border": {
      "subtle": {
        "$value": "#E4DCCB",
        "$type": "color"
      },
      "strong": {
        "$value": "#CFC5B2",
        "$type": "color"
      }
    },
    "semantic": {
      "success": {
        "fg": { "$value": "#2E5B46", "$type": "color" },
        "bg": { "$value": "#E4F0EA", "$type": "color" }
      },
      "warning": {
        "fg": { "$value": "#8A6500", "$type": "color" },
        "bg": { "$value": "#FEF3C7", "$type": "color" }
      },
      "error": {
        "fg": { "$value": "#B9382E", "$type": "color" },
        "bg": { "$value": "#FDE8E6", "$type": "color" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "display": {
        "$value": "'Recoleta', 'Fraunces', Georgia, serif",
        "$type": "fontFamily"
      },
      "sans": {
        "$value": "'Plus Jakarta Sans', 'DM Sans', system-ui, sans-serif",
        "$type": "fontFamily"
      }
    },
    "fontSize": {
      "displayXl": { "$value": "48px", "$type": "dimension" },
      "displayLg": { "$value": "36px", "$type": "dimension" },
      "headingMd": { "$value": "24px", "$type": "dimension" },
      "bodyLg": { "$value": "18px", "$type": "dimension" },
      "bodyMd": { "$value": "16px", "$type": "dimension" },
      "uiLabel": { "$value": "14px", "$type": "dimension" },
      "uiBadge": { "$value": "12px", "$type": "dimension" }
    }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "2xl": { "$value": "48px", "$type": "dimension" },
    "3xl": { "$value": "64px", "$type": "dimension" }
  },
  "shadow": {
    "card": {
      "$value": "0 8px 24px -6px rgba(30, 29, 27, 0.08)",
      "$type": "shadow"
    },
    "floating": {
      "$value": "0 16px 40px -8px rgba(30, 29, 27, 0.12)",
      "$type": "shadow"
    }
  }
}
