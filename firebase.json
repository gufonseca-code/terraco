{
  "firestore": {
    "database": "(default)",
    "location": "us-central1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": {
    "backendId": "terraco",
    "rootDir": "/apps/web-seo",
    "ignore": [
      "node_modules",
      ".git",
      "dist",
      ".angular",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "hosting": [
    {
      "target": "web-seo",
      "public": "apps/web-seo/dist/web-seo/browser",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.*",
        "!**/.well-known",
        "!**/.well-known/**",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|woff2|svg|png|jpg|jpeg|webp|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/.well-known/@(ard|ai-catalog).json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, s-maxage=86400"
            }
          ]
        },
        {
          "source": "/llms.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, s-maxage=86400"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Link",
              "value": "</.well-known/ard.json>; rel=\"ard\""
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "mobile-app",
      "public": "apps/mobile-app/build/web",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "!**/.well-known",
        "!**/.well-known/**",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
